{
  "name": "kint",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "vase:placeholder": "node scripts/make-vase.mjs && node scripts/build-vase.mjs",
    "vase:build": "node scripts/build-vase.mjs",
    "vase:check": "node scripts/check-vase.mjs",
    "check": "npm test && node scripts/check-functions.mjs && npm run vase:check && npm run build && node scripts/check-budget.mjs && node scripts/check-html.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edo404/kint.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Edo404/kint/issues"
  },
  "homepage": "https://github.com/Edo404/kint#readme",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.3.5",
    "lenis": "^1.3.26",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true
}
