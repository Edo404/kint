---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Opening from '../../components/Opening.astro';
import Presentation from '../../components/Presentation.astro';
import Sectors from '../../components/Sectors.astro';
import Services from '../../components/Services.astro';
import { loadAll } from '../../lib/content';
import { buildEnv, portfolioPublished } from '../../lib/flags';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return loadAll().available.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const { content, available } = loadAll();
const c = content[lang]!;
const showPortfolio = portfolioPublished(buildEnv());
---
<Base lang={lang} path="" title={c.meta.title} description={c.meta.description} ogLocale={c.meta.og_locale} ogLocaleAlternate={c.meta.og_locale_alternate}>
  <a class="skip-link" href="#kint">{c.ui.skip_to_content}</a>
  <canvas id="canvas" aria-hidden="true"></canvas>
  <Nav c={c} lang={lang} available={available} showPortfolio={showPortfolio} />
  <main>
    <Opening c={c} />
    <Presentation c={c} />
    <Sectors c={c} />
    <Services c={c} />
  </main>
  <script>
    import { boot } from '../../gl/boot';
    import { initNavReveal } from '../../scripts/nav-reveal';
    boot();
    initNavReveal();
  </script>
</Base>
