---
// Settori: una scheda per ogni sotto-landing di settore (logo, a chi si rivolge, link).
// Indirizzi e loghi in site.yaml, testi nei file di lingua; si collegano per id.
// I 9 settori dettagliati restano nei dati (modulo contatti, portfolio, JSON-LD, llms) ma non qui.
import SectionTitle from './SectionTitle.astro';
import Seam from './Seam.astro';
import { ui } from '../lib/icons';
import type { Content, SiteData } from '../lib/content.types';
interface Props { c: Content; site: SiteData }
const { c, site } = Astro.props;
const byId = new Map(site.landings.map((l) => [l.id, l]));
const cards = c.sectors.landings.map((t) => {
  const l = byId.get(t.id);
  if (!l) throw new Error(`site.yaml: manca la sotto-landing "${t.id}"`);
  return { ...t, ...l };
});
---
<section id="settori" class="block" aria-labelledby="settori-title">
  <Seam at="34%" />
  <div class="wrap">
    <SectionTitle id="settori-title" text={c.sectors.title} intro={c.sectors.intro} index={1} chapter={c.nav.sectors} />
    <ul class="landings">
      {cards.map((l, i) => (
        <li data-inview style={`--i:${i}`}>
          <a id={`settori-${l.id}`} class="landing" href={l.url} data-spotlight>
            <span class="card-glow" aria-hidden="true"></span>
            <img class="landing-logo" src={l.logo} alt={l.logo_alt} width={l.logo_width} height={l.logo_height} loading="lazy" decoding="async" />
            <h3 class="landing-name">{l.name}</h3>
            <span class="landing-line">{l.line}</span>
            <span class="landing-cta">{c.ui.discover}<span class="arrow" aria-hidden="true" set:html={ui.arrowRight} /></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="closing-link" data-inview>
      <a href="#contatti">{c.sectors.closing.text}<span class="arrow" aria-hidden="true" set:html={ui.arrowRight} /></a>
    </p>
  </div>
</section>
