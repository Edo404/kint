---
import LangSwitch from './LangSwitch.astro';
import { pathFor, type Lang } from '../lib/i18n';
import type { Content } from '../lib/content.types';
interface Props { c: Content; lang: Lang; available: Lang[]; path?: string; showPortfolio?: boolean }
const { c, lang, available, path = '', showPortfolio = false } = Astro.props;
const home = pathFor(lang);
---
<header class="site-nav" data-nav>
  <a class="brand" href={home} aria-label="Kint">Kint</a>
  <nav aria-label={c.ui.nav_label}>
    <ul>
      <li><a href={`${home}#settori`}>{c.nav.sectors}</a></li>
      <li><a href={`${home}#servizi`}>{c.nav.services}</a></li>
      <li><a href={`${home}#contatti`}>{c.nav.contact}</a></li>
      {showPortfolio && <li><a href={pathFor(lang, 'portfolio')}>{c.nav.portfolio}</a></li>}
    </ul>
  </nav>
  <LangSwitch lang={lang} available={available} path={path} label={c.ui.lang_label} />
</header>
