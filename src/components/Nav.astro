---
// Barra a pillola sospesa, centrata in alto: logo | sezioni + Contattaci | lingua.
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';
import { pathFor, type Lang } from '../lib/i18n';
import type { Content } from '../lib/content.types';
interface Props { c: Content; lang: Lang; available: Lang[]; path?: string; showPortfolio?: boolean }
const { c, lang, available, path = '', showPortfolio = false } = Astro.props;
const home = pathFor(lang);
---
<header class="site-nav" data-nav>
  <div class="nav-pill">
    <a class="brand" href={home} aria-label="Kint"><Logo class="nav-logo" /></a>
    <span class="nav-sep" aria-hidden="true"></span>
    <nav class="nav-main" aria-label={c.ui.nav_label}>
      <ul>
        <li><a href={`${home}#settori`} data-nav-link="settori">{c.nav.sectors}</a></li>
        <li><a href={`${home}#servizi`} data-nav-link="servizi">{c.nav.services}</a></li>
        {showPortfolio && <li><a href={pathFor(lang, 'portfolio')} aria-current={path === 'portfolio' ? 'page' : undefined}>{c.nav.portfolio}</a></li>}
        <li><a class="nav-cta" href={`${home}#contatti`}><span class="cta-full">{c.nav.contact_cta}</span><span class="cta-short" aria-hidden="true">{c.nav.contact}</span></a></li>
      </ul>
    </nav>
    <span class="nav-sep" aria-hidden="true"></span>
    <LangSwitch lang={lang} available={available} path={path} label={c.ui.lang_label} />
  </div>
</header>
<script>
  import { initLangMenu } from '../scripts/lang-menu';
  import { initNavActive } from '../scripts/nav-active';
  initLangMenu();
  initNavActive();
</script>
