---
// Logo "kint." ufficiale: k e punto in oro, "int" chiaro (forme in src/lib/kintLogo.ts).
import { LOGO, LOGO_SHAPES } from '../lib/kintLogo';
interface Props { class?: string; label?: string }
const { class: extra, label } = Astro.props;
---
<svg class:list={['kint-mark', extra]} viewBox={LOGO.viewBox} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {LOGO_SHAPES.map((s) => {
    const Tag = s.tag;
    return <Tag {...s.attrs} fill={LOGO[s.tone]} fill-rule="evenodd" />;
  })}
</svg>
