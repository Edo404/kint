---
// Footer: cucitura d'oro spezzata in testa (stessa geometria dei bordi delle sezioni coperte, si disegna
// quando entra in vista), poi logo, sezioni e social; sotto, copyright, email, hosting e privacy.
// Su desktop Settori ha sotto i loghi delle sotto-landing a ramo; Servizi e Contatti stanno accanto, sulla stessa riga.
// I social sono i profili in site.yaml → same_as (gli stessi del JSON-LD).
import KintMark from './KintMark.astro';
import type { Content, SiteData } from '../lib/content.types';
import { pathFor, type Lang } from '../lib/i18n';
import { edgePath, jaggedEdge, shardClip } from '../lib/shard';
import { countryFlags, socialFor } from '../lib/icons';
interface Props { c: Content; lang: Lang; site: SiteData; showPortfolio?: boolean }
const { c, lang, site, showPortfolio = false } = Astro.props;
const home = pathFor(lang);
const EDGE = 22;
const edge = jaggedEdge(47, EDGE);
const seam = edgePath(edge, EDGE);
// lo sfondo parte dalla cucitura: sopra la linea si vede ancora il vaso
const clip = shardClip(edge, [{ x: 0, y: 0 }, { x: 100, y: 0 }]);
// sotto-landing sotto Settori, con i loro loghi (site.yaml → landings)
const subs = site.landings;
const socials = site.same_as.flatMap((url) => {
  const s = socialFor(url);
  return s ? [{ url, ...s }] : [];
});
---
<footer class="site-footer" style={`--footer-clip:${clip}`}>
  <svg class="footer-seam" viewBox={`0 0 1440 ${EDGE}`} preserveAspectRatio="none" aria-hidden="true" data-inview>
    <path d={seam} pathLength="1" />
  </svg>
  <div class="footer-main">
    <a class="footer-brand" href={home} aria-label="Kint"><KintMark /></a>
    <nav class="footer-nav" aria-label={c.footer.nav_label}>
      <ul>
        <li class="footer-nav-sectors">
          <a href={`${home}#settori`}>{c.nav.sectors}</a>
          <ul class="footer-sub">
            {subs.map((l) => (
              <li><a href={l.url} style={`--accent:${l.accent}`}><img src={l.logo} alt={l.logo_alt} width={l.logo_width} height={l.logo_height} loading="lazy" decoding="async" /></a></li>
            ))}
          </ul>
        </li>
        <li><a href={`${home}#servizi`}>{c.nav.services}</a></li>
        {showPortfolio && <li><a href={pathFor(lang, 'portfolio')}>{c.nav.portfolio}</a></li>}
        <li><a href={`${home}#contatti`}>{c.nav.contact}</a></li>
      </ul>
    </nav>
    {socials.length > 0 && (
      <ul class="footer-social">
        {socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener"><span class="social-icon" aria-hidden="true" set:html={s.icon} />{s.name}</a></li>
        ))}
      </ul>
    )}
  </div>
  <div class="footer-base">
    <p>{c.footer.copyright}</p>
    <ul>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li>{c.footer.hosting}</li>
      <li><a href={pathFor(lang, 'privacy')}>{c.footer.privacy}</a></li>
    </ul>
  </div>
  <!-- ultime su mobile; su desktop salgono sotto i social (order in site.css) -->
  <div class="footer-flags" role="img" aria-label={c.footer.countries}>
    {countryFlags.map((f) => <span class="flag" aria-hidden="true" set:html={f} />)}
  </div>
</footer>
