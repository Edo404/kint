---
import { splitEmphasis } from '../lib/emphasis';
import { edgePath, jaggedEdge } from '../lib/shard';
import type { Content } from '../lib/content.types';
interface Props { c: Content }
const { c } = Astro.props;
const p = c.presentation;
const h = splitEmphasis(p.h1);
// La cucitura d'oro che unisce i quattro valori: una crepa orizzontale (da 1024px) con un punto per ogni valore.
const SEAM = 16;
// I punti dei valori (in % della larghezza) stanno esattamente sulla linea: lì la crepa passa dalla riga di mezzo.
const STITCHES = [0.44, 26.34, 52.2, 78.1];
const seamPts = [...jaggedEdge(52, SEAM).filter((q) => STITCHES.every((x) => Math.abs(q.x - x) > 4)), ...STITCHES.map((x) => ({ x, y: SEAM / 2 }))].sort((a, b) => a.x - b.x);
const seam = edgePath(seamPts, SEAM);
---
<section id="kint" aria-labelledby="kint-title">
  <div class="wrap">
    <h1 id="kint-title" class="hero-title">{h.lead}<span class="stitch">{h.word}</span>{h.tail}</h1>
    <p class="subtitle">{p.subtitle}</p>
    <p class="hero-text">{p.paragraph}</p>
    <p class="hero-name">{p.kintsugi.text}</p>
    <p class="cta-row">
      <a class="btn btn-gold" href={p.cta_primary.href}>{p.cta_primary.label}</a>
      {p.cta_secondary && <a class="btn btn-ghost" href={p.cta_secondary.href}>{p.cta_secondary.label}</a>}
    </p>
    <div class="values-wrap" data-inview>
      <svg class="values-seam" viewBox={`0 0 1440 ${SEAM}`} preserveAspectRatio="none" aria-hidden="true"><path d={seam} pathLength="1" /></svg>
    <ol class="values">
      {p.values.map((v, i) => (
        <li data-inview style={`--i:${i}`}>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>
