---
// Contatti: un pannello (guscio) con titolo e due strade in due nuclei laccati (.contact-core), parlare (la call) e scrivere (il modulo), separate da una crepa d'oro
// spezzata come quelle del resto del sito. I nomi dei campi sono quelli letti da functions/api/contact.ts.
import Faq from './Faq.astro';
import SectionTitle from './SectionTitle.astro';
import { leadNumber, sentences } from '../lib/emphasis';
import { ui, uiLight } from '../lib/icons';
import { edgePath, jaggedEdge } from '../lib/shard';
import type { Content, SiteData } from '../lib/content.types';
import { pathFor, type Lang } from '../lib/i18n';
interface Props { c: Content; lang: Lang; site: SiteData }
const { c, lang, site } = Astro.props;
const f = c.contact.form;
const d = c.contact.details;
// Senza link di prenotazione, la CTA porta al modulo.
const callHref = site.call_url ?? '#contatti-form';
// Durata della prima call in grande ("20" da "Prima call: 20 minuti online"), solo decorativa.
const minutes = leadNumber(c.contact.call.title);
// Il testo della call, una frase per riga con la spunta.
const points = sentences(c.contact.call.text);
// Crepa tra le due metà: orizzontale su telefono (viewBox 1440×24), verticale da 900px (viewBox 24×600).
const SEAM = 24;
const seamPts = jaggedEdge(31, SEAM);
const seamH = edgePath(seamPts, SEAM);
const seamV = seamPts.map((p, i) => `${i ? 'L' : 'M'}${p.y.toFixed(1)} ${(p.x * 6).toFixed(1)}`).join(' ');
const details = [
  { label: d.labels.email, value: d.email, href: `mailto:${d.email}` },
  { label: d.labels.address, value: d.address },
  d.phone && { label: d.labels.phone, value: d.phone, href: `tel:${d.phone.replace(/\s/g, '')}` },
  d.hours && { label: d.labels.hours, value: d.hours },
].filter(Boolean) as Array<{ label: string; value: string; href?: string }>;
---
<section id="contatti" class="block" aria-labelledby="contatti-title">
  <div class="wrap">
    <div class="panel contact-panel" data-inview>
      <span class="panel-rule" aria-hidden="true"></span>
      <div class="panel-glow" aria-hidden="true"></div>
      <SectionTitle id="contatti-title" text={c.contact.title} intro={c.contact.intro} />

      <div class="contact-call contact-core">
        <div class="call-head">
          {minutes && <span class="call-time" aria-hidden="true">{minutes}<span>′</span></span>}
          <h3 id="call-title">{c.contact.call.title}</h3>
        </div>
        <ul class="call-points">
          {points.map((p) => <li><span class="point-icon" aria-hidden="true" set:html={uiLight.check} />{p}</li>)}
        </ul>
        <a class="btn btn-gold btn-island" href={callHref}>{c.contact.call.cta_label}<span class="btn-orb" aria-hidden="true" set:html={uiLight.calendarCheck} /></a>
        <address class="contact-details">
          <ul>
            {details.map((x) => (
              <li>
                <span class="details-label">{x.label}</span>
                {x.href ? <a href={x.href}>{x.value}</a> : <span>{x.value}</span>}
              </li>
            ))}
          </ul>
        </address>
      </div>

      <div class="contact-seam" aria-hidden="true">
        <svg class="seam-h" viewBox={`0 0 1440 ${SEAM}`} preserveAspectRatio="none"><path d={seamH} pathLength="1" /></svg>
        <svg class="seam-v" viewBox={`0 0 ${SEAM} 600`} preserveAspectRatio="none"><path d={seamV} pathLength="1" /></svg>
      </div>

      <form id="contatti-form" class="contact-form contact-core" method="post" action="/api/contact" aria-labelledby="form-title" data-contact-form>
        <div class="form-body">
          <h3 id="form-title">{f.title}</h3>
          <input type="hidden" name="lang" value={lang} />
          <p class="hp" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="field-row">
            <label class="field"><span class="field-label">{f.name}</span><input name="name" type="text" autocomplete="name" required /></label>
            <label class="field"><span class="field-label">{f.email}</span><input name="email" type="email" autocomplete="email" required /></label>
          </div>
          <div class="field-row">
            <label class="field"><span class="field-label">{f.phone}<em>{f.optional}</em></span><input name="phone" type="tel" autocomplete="tel" /></label>
            <label class="field"><span class="field-label">{f.company}<em>{f.optional}</em></span><input name="company" type="text" autocomplete="organization" /></label>
          </div>
          <label class="field">
            <span class="field-label">{f.sector}<em>{f.optional}</em></span>
            <span class="select">
              <select name="sector">
                <option value="" selected>{f.sector_pick}</option>
                {c.sectors.items.map((s) => <option value={s.id}>{s.name}</option>)}
                <option value="other">{f.sector_other}</option>
              </select>
              <span class="select-caret" aria-hidden="true" set:html={ui.caretDown} />
            </span>
          </label>
          <label class="field"><span class="field-label">{f.message}</span><textarea name="message" rows="4" required></textarea></label>
          <label class="check"><input type="checkbox" name="privacy" required /><a href={pathFor(lang, 'privacy')}>{f.privacy_label}</a></label>
          <p class="form-error" role="alert" data-form-error hidden>{f.error}</p>
          <button class="btn btn-gold btn-island" type="submit">{f.submit}<span class="btn-orb" aria-hidden="true" set:html={uiLight.arrowRight} /></button>
        </div>
        <div class="form-done" role="status" tabindex="-1" data-form-sent>
          <span class="done-icon" aria-hidden="true" set:html={uiLight.checkCircle} />
          <p>{f.sent}</p>
        </div>
      </form>
    </div>

    <Faq c={c} />
  </div>
</section>
