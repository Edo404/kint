---
import SectionTitle from './SectionTitle.astro';
import { iconFor } from '../lib/icons';
import { edgePath, jaggedEdge, shardClip, veinTile } from '../lib/shard';
import type { Content } from '../lib/content.types';
interface Props { c: Content }
const { c } = Astro.props;
const s = c.services;
// Sezione "coperta": copre il vaso come un coccio, con bordi frastagliati cuciti d'oro e venature.
const EDGE = 28;
const top = jaggedEdge(21, EDGE);
const bottom = jaggedEdge(34, EDGE);
const coverStyle = `clip-path:${shardClip(top, bottom)};--veins:${veinTile(5)}`;
// Ogni crepa ha un tracciato diverso, scelto dall'indice del servizio.
const CRACKS = [
  'M2 12 L22 7 L34 15 L52 5 L66 13 L86 8 L98 14',
  'M2 8 L18 14 L36 6 L48 12 L70 5 L84 13 L98 9',
  'M2 14 L20 9 L30 14 L50 6 L62 12 L80 7 L98 12',
];
---
<section id="servizi" class="block cover" aria-labelledby="servizi-title" style={coverStyle} data-cover>
  <div class="cover-bg" aria-hidden="true">
    <div class="cover-veins"></div>
    <div class="cover-lit" data-cover-lit></div>
  </div>
  <svg class="cover-edge cover-edge-top" viewBox={`0 0 1440 ${EDGE}`} preserveAspectRatio="none" aria-hidden="true" data-inview>
    <path d={edgePath(top, EDGE)} pathLength="1" />
  </svg>
  <svg class="cover-edge cover-edge-bottom" viewBox={`0 0 1440 ${EDGE}`} preserveAspectRatio="none" aria-hidden="true" data-inview>
    <path d={edgePath(bottom, EDGE, true)} pathLength="1" />
  </svg>
  <div class="wrap">
    <div class="repair-track" data-repair-track>
      <div class="repair-pin" data-repair-pin>
        <SectionTitle id="servizi-title" text={s.title} intro={s.intro} index={2} chapter={c.nav.services} />

        <div class="service-grid" data-repair-grid>
          {s.items.map((item, i) => (
            <article
              id={`servizi-${item.id}`}
              class="card service"
              data-spotlight
              data-inview
              style={`--i:${i % 3}`}
              data-state="gold"
            >
              <div class="card-glow" aria-hidden="true"></div>
              <div class="service-top">
                <span class="icon-tile" aria-hidden="true" set:html={iconFor(item.id)} />
                <span class="service-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{item.title}</h3>
              <p class="desc">{item.description}</p>
              <div class="repair">
                <svg class="crack-line" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path class="crack-base" d={CRACKS[i % CRACKS.length]} />
                  <path class="crack-gold" d={CRACKS[i % CRACKS.length]} pathLength="1" />
                </svg>
                <div class="repair-faces">
                  <p class="crack"><span class="label">{c.ui.crack}</span>{item.crack}</p>
                  <p class="gold"><span class="label">{c.ui.gold}</span>{item.gold}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
