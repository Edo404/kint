---
// Layout leggero per la vista Machine: solo token, font monospazio e lo stile della pagina che lo usa.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css'; // titoli e grassetti della vista Machine
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import type { ComponentProps } from 'astro/types';
type Props = ComponentProps<typeof SeoHead>;
---
<!doctype html>
<html lang={Astro.props.lang}>
  <head>
    <SeoHead {...Astro.props} />
  </head>
  <body>
    <slot />
  </body>
</html>
