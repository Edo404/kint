---
import '../styles/global.css';
import '../styles/site.css';
import { absoluteUrl, alternatesFor, pathFor, type Lang } from '../lib/i18n';
import { buildEnv, noindex } from '../lib/flags';
import { loadAll } from '../lib/content';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  ogLocale: string;
  ogLocaleAlternate?: string;
  jsonld?: object[];
}
const { lang, path, title, description, ogLocale, ogLocaleAlternate, jsonld = [] } = Astro.props;
const { available } = loadAll();
const alternates = alternatesFor(available, path);
const canonical = absoluteUrl(pathFor(lang, path));
const robots = noindex(buildEnv()) ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang={lang} data-mode="webgl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kint" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternate && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    {jsonld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
